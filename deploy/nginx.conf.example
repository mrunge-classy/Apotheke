# Sample nginx server block reverse-proxying apotheke.zugriff.at to the
# Next.js process started via PM2 (see ecosystem.config.js / DEPLOYMENT.md).
#
# Copy to /etc/nginx/sites-available/apotheke.zugriff.at, adjust as needed,
# then: ln -s /etc/nginx/sites-available/apotheke.zugriff.at /etc/nginx/sites-enabled/
# and run `certbot --nginx -d apotheke.zugriff.at` to provision TLS.

server {
    listen 80;
    listen [::]:80;
    server_name apotheke.zugriff.at;

    # certbot will add its own location block + redirect to https here
    # once TLS is provisioned. Until then this serves plain HTTP.

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header Referrer-Policy strict-origin-when-cross-origin;
}
